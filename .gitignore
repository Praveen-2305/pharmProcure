# ==========================================
# AutonoSource (.gitignore)
# ==========================================

# Environment variables & secrets
.env
.env.*
!.env.example

# Node / Frontend Dependencies & Builds
node_modules/
frontend/node_modules/
dist/
frontend/dist/
frontend/build/
!backend/build/

.pnpm-store/
.yarn/

# Python & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
env.bak/
venv.bak/
backend/env/
backend/venv/
.venv/
backend/.venv/

# AI Vector Stores, Graph Storage & Databases
.chroma/
chroma_db/
qdrant_storage/
backend/qdrant_storage/
backend/data/*.db
backend/data/*.sqlite
backend/data/*.graphml
*.sqlite3

# Logs & Monitoring
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.langsmith/

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/
coverage/
frontend/coverage/

# Scratch & Temporary Developer Output
scratch/
tmp/
*.tmp

# Operating System & IDE Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
