# ==========================================
# AutonoSource (.gitignore)
# Master Git Ignore Configuration
# ==========================================

# ------------------------------------------
# Environment variables & secrets
# ------------------------------------------
.env
.env.*
!.env.example
*.env
backend/.env
backend/.env.*
!backend/.env.example
frontend/.env
frontend/.env.*
!frontend/.env.example

# ------------------------------------------
# Node / Frontend Dependencies & Builds
# ------------------------------------------
node_modules/
frontend/node_modules/
dist/
frontend/dist/
frontend/build/
!backend/build/

.pnpm-store/
.yarn/
*.tsbuildinfo

# ------------------------------------------
# Python & Virtual Environments
# ------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
env.bak/
venv.bak/
backend/env/
backend/venv/
.venv/
backend/.venv/
*.egg-info/
.eggs/

# ------------------------------------------
# AI Vector Stores, Locks & Databases
# ------------------------------------------
.chroma/
chroma_db/
qdrant_storage/
backend/qdrant_storage/
backend/data/*.db
backend/data/*.sqlite
backend/data/*.graphml
*.sqlite3
*.lock
backend/processed_data/qdrant/.lock

# ------------------------------------------
# Logs & Monitoring
# ------------------------------------------
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.langsmith/

# ------------------------------------------
# Testing & Coverage
# ------------------------------------------
.pytest_cache/
.coverage
htmlcov/
coverage/
frontend/coverage/

# ------------------------------------------
# Scratch & Temporary Developer Output
# ------------------------------------------
scratch/
tmp/
*.tmp
temp/
backend/processed_data/uploads/
Scratchpad/

# ------------------------------------------
# Operating System & IDE Files
# ------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.sw?
.kilo/
