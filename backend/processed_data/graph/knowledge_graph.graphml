      <data key="d7">STANDARDIZED_UNDER</data>
      <data key="d8">1</data>
      <data key="d9">["Humidity control shall be achieved by removing moisture from the air, or adding moisture to the air, as relevant."]</data>
      <data key="d10">chunk_1847..chunk_1849</data>
      <data key="d11">drugs_and_cosmetics_rules_1945_updated_2024.md</data>
