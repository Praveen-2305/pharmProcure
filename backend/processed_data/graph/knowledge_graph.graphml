      <data key="d10">chunk_7165..chunk_7167</data>
      <data key="d11">who_gmp_guidelines.md</data>
    </edge>
    <edge source="cleaning and disinfection procedures" target="who good manufacturing practices" id="0">
      <data key="d7">STANDARDIZED_UNDER</data>
      <data key="d8">1</data>
      <data key="d9">["Premises should be cleaned and, where applicable, disinfected according to detailed written procedures."]</data>
      <data key="d10">chunk_7114..chunk_7116</data>
      <data key="d11">who_gmp_guidelines.md</data>
    </edge>
    <edge source="temperature humidity ventilation control" target="who good manufacturing practices" id="0">
      <data key="d7">STANDARDIZED_UNDER</data>
      <data key="d8">1</data>
      <data key="d9">["Electrical supply, lighting, temperature, humidity and ventilation should be appropriate and such that they do not adversely affect, directly or indirectly, either the pharmaceutical products during their manufacture and storage, or the accurate functioning of equipment."]</data>
      <data key="d10">chunk_7114..chunk_7116</data>
      <data key="d11">who_gmp_guidelines.md</data>
    </edge>
    <edge source="rodent and pest control" target="who good manufacturing practices" id="0">
      <data key="d7">STANDARDIZED_UNDER</data>
      <data key="d8">1</data>
      <data key="d9">["Premises should be designed and equipped so as to afford maximum protection against the entry of insects, birds or other animals. There should be a procedure for rodent and pest control."]</data>
      <data key="d10">chunk_7114..chunk_7116</data>
      <data key="d11">who_gmp_guidelines.md</data>
    </edge>
    <edge source="separate rest and refreshment rooms" target="who good manufacturing practices" id="0">
      <data key="d7">STANDARDIZED_UNDER</data>
      <data key="d8">1</data>
      <data key="d9">["Rest and refreshment rooms should be separate from manufacturing and control areas."]</data>
      <data key="d10">chunk_7114..chunk_7116</data>
      <data key="d11">who_gmp_guidelines.md</data>
    </edge>
    <edge source="premises design for cross contamination control" target="who good manufacturing practices" id="0">
      <data key="d7">STANDARDIZED_UNDER</data>
      <data key="d8">1</data>
      <data key="d9">["The layout and design of premises must aim to minimize the risk of errors and permit effective cleaning and maintenance in order to avoid cross\u2011contamination, build\u2011up of dust or dirt, and in general, any adverse effect on the quality of products."]</data>
      <data key="d10">chunk_7114..chunk_7116</data>
      <data key="d11">who_gmp_guidelines.md</data>
    </edge>
    <edge source="separate air supply" target="who gmp guidelines" id="0">
      <data key="d7">STANDARDIZED_UNDER</data>
      <data key="d8">1</data>
      <data key="d9">["There should be separate air supply to laboratories and production areas."]</data>
      <data key="d10">chunk_9802..chunk_9804</data>
      <data key="d11">who_gmp_guidelines.md</data>
    </edge>
    <edge source="good documentation" target="who good manufacturing practices" id="0">
      <data key="d7">STANDARDIZED_UNDER</data>
      <data key="d8">1</data>
      <data key="d9">["Good documentation is an essential part of the quality assurance system and, as such, should exist for all aspects of GMP."]</data>
      <data key="d10">chunk_7138..chunk_7140</data>
      <data key="d11">who_gmp_guidelines.md</data>
    </edge>
    <edge source="batch processing record" target="who good manufacturing practices" id="0">
      <data key="d7">STANDARDIZED_UNDER</data>
      <data key="d8">1</data>
      <data key="d9">["A batch processing record should be kept for each batch processed."]</data>
      <data key="d10">chunk_7150..chunk_7152</data>
      <data key="d11">who_gmp_guidelines.md</data>
    </edge>
    <edge source="batch packaging record" target="who good manufacturing practices" id="0">
      <data key="d7">STANDARDIZED_UNDER</data>
      <data key="d8">1</data>
      <data key="d9">["A batch packaging record should be kept for each batch or part batch processed."]</data>
      <data key="d10">chunk_7150..chunk_7152</data>
      <data key="d11">who_gmp_guidelines.md</data>
    </edge>
    <edge source="in process controls" target="who good manufacturing practices" id="0">
      <data key="d7">STANDARDIZED_UNDER</data>
      <data key="d8">1</data>
      <data key="d9">["the in-process controls performed, the initials of the person(s) carrying them out, and the results obtained;"]</data>
      <data key="d10">chunk_7150..chunk_7152</data>
      <data key="d11">who_gmp_guidelines.md</data>
    </edge>
    <edge source="in process controls" target="who gmp guidelines" id="0">
      <data key="d7">STANDARDIZED_UNDER</data>
      <data key="d8">1</data>
      <data key="d9">["16.16 Any necessary in-process controls and environmental controls should be carried out and recorded. (chunk_7166)"]</data>
      <data key="d10">chunk_7165..chunk_7167</data>
      <data key="d11">who_gmp_guidelines.md</data>
    </edge>
    <edge source="written release and rejection procedures" target="who gmp guidelines" id="0">
      <data key="d7">STANDARDIZED_UNDER</data>
      <data key="d8">1</data>
      <data key="d9">["15.44 Written release and rejection procedures should be available for materials and products, and in particular for the release for sale of the finished product by an authorized person."]</data>
      <data key="d10">chunk_7159..chunk_7161</data>
      <data key="d11">who_gmp_guidelines.md</data>
    </edge>
    <edge source="batch distribution records" target="who gmp guidelines" id="0">
      <data key="d7">STANDARDIZED_UNDER</data>
      <data key="d8">1</data>
      <data key="d9">["15.45 Records should be maintained of the distribution of each batch of a product in order, for example, to facilitate the recall of the batch if necessary."]</data>
      <data key="d10">chunk_7159..chunk_7161</data>
      <data key="d11">who_gmp_guidelines.md</data>
    </edge>
    <edge source="equipment validation and maintenance records" target="who gmp guidelines" id="0">
      <data key="d7">STANDARDIZED_UNDER</data>
      <data key="d8">1</data>
      <data key="d9">["15.46 Records should be kept for major and critical equipment, as appropriate, of any validations, calibrations, maintenance, cleaning or repair operations, including dates and the identity of the people who carried out these operations."]</data>
      <data key="d10">chunk_7159..chunk_7161</data>
      <data key="d11">who_gmp_guidelines.md</data>
    </edge>
    <edge source="equipment usage recording" target="who gmp guidelines" id="0">
      <data key="d7">STANDARDIZED_UNDER</data>
      <data key="d8">1</data>
      <data key="d9">["15.47 The use of major and critical equipment and the areas where products have been processed should be appropriately recorded in chronological order."]</data>
      <data key="d10">chunk_7159..chunk_7161</data>
      <data key="d11">who_gmp_guidelines.md</data>
    </edge>
    <edge source="cleaning and sanitation procedures" target="who gmp guidelines" id="0">
      <data key="d7">STANDARDIZED_UNDER</data>
      <data key="d8">1</data>
      <data key="d9">["15.48 There should be written procedures assigning responsibility for cleaning and sanitation and describing in sufficient detail the cleaning schedules, methods, equipment and materials to be used and facilities and equipment to be cleaned. Such written procedures should be followed."]</data>
      <data key="d10">chunk_7159..chunk_7161</data>
      <data key="d11">who_gmp_guidelines.md</data>
    </edge>
    <edge source="production operation procedures" target="who gmp guidelines" id="0">
      <data key="d7">STANDARDIZED_UNDER</data>
      <data key="d8">1</data>
      <data key="d9">["16.1 Production operations must follow clearly defined procedures in accordance with manufacturing and marketing authorizations, with the objective of obtaining products of the requisite quality."]</data>
      <data key="d10">chunk_7159..chunk_7161</data>
      <data key="d11">who_gmp_guidelines.md</data>
    </edge>
    <edge source="material handling procedures" target="who gmp guidelines" id="0">
      <data key="d7">STANDARDIZED_UNDER</data>
      <data key="d8">1</data>
      <data key="d9">["16.2 All handling of materials and products, such as receipt and cleaning, quarantine, sampling, storage, labelling, dispensing, processing, packaging and distribution should be done in accordance with written procedures or instructions and, where necessary, recorded."]</data>
      <data key="d10">chunk_7159..chunk_7161</data>
      <data key="d11">who_gmp_guidelines.md</data>
    </edge>
    <edge source="deviation approval procedure" target="who gmp guidelines" id="0">
      <data key="d7">STANDARDIZED_UNDER</data>
      <data key="d8">1</data>
      <data key="d9">["16.3 Deviation from instructions or procedures should be avoided as far as possible. If deviations occur, they should be in accordance with an approved procedure. The authorization of the deviation should be approved in writing by a designated person, with the involvement of the QC department, when appropriate."]</data>
      <data key="d10">chunk_7159..chunk_7161</data>
      <data key="d11">who_gmp_guidelines.md</data>
    </edge>
    <edge source="equipment maintenance hazard prevention" target="who gmp guidelines" id="0">
      <data key="d7">STANDARDIZED_UNDER</data>
      <data key="d8">1</data>
      <data key="d9">["Repair and maintenance operations should not present any hazard to the quality of the products."]</data>
      <data key="d10">chunk_7168..chunk_7170</data>
      <data key="d11">who_gmp_guidelines.md</data>
    </edge>
    <edge source="packaging line clearance" target="who gmp guidelines" id="0">
      <data key="d7">STANDARDIZED_UNDER</data>
      <data key="d8">1</data>
      <data key="d9">["The line clearance should be performed according to an appropriate procedure and checklist, and recorded."]</data>
      <data key="d10">chunk_7168..chunk_7170</data>
      <data key="d11">who_gmp_guidelines.md</data>
    </edge>
    <edge source="label display" target="who gmp guidelines" id="0">
      <data key="d7">STANDARDIZED_UNDER</data>
      <data key="d8">1</data>
      <data key="d9">["The name and batch number of the product being handled should be displayed at each packaging station or line."]</data>
      <data key="d10">chunk_7168..chunk_7170</data>
      <data key="d11">who_gmp_guidelines.md</data>
    </edge>
    <edge source="label verification" target="who gmp guidelines" id="0">
      <data key="d7">STANDARDIZED_UNDER</data>
      <data key="d8">2</data>
      <data key="d9">["The correct performance of any printing (e.g. of code numbers or expiry dates) done separately or in the course of the packaging should be checked and recorded.", "Online verification of all labels by automated electronic means can be helpful in preventing mix ups, but checks should be made to ensure that any electronic code readers, label counters, or similar devices are operating correctly."]</data>
      <data key="d10">chunk_7168..chunk_7170</data>
      <data key="d11">who_gmp_guidelines.md</data>
    </edge>
    <edge source="label fade resistance" target="who gmp guidelines" id="0">
      <data key="d7">STANDARDIZED_UNDER</data>
      <data key="d8">1</data>
      <data key="d9">["Printed and embossed information on packaging materials should be distinct and resistant to fading or erasing."]</data>
      <data key="d10">chunk_7168..chunk_7170</data>
      <data key="d11">who_gmp_guidelines.md</data>
