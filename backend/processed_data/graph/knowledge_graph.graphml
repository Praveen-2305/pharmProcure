    </edge>
    <edge source="low relative humidity area separation" target="drugs rules 1945" id="0">
      <data key="d7">STANDARDIZED_UNDER</data>
      <data key="d8">1</data>
      <data key="d9">["Cubicles or suites, in which products requiring low relative humidity are processed, shall have well sealed walls and ceilings and shall also be separated from adjacent areas with higher relative humidity by means of suitable airlocks."]</data>
      <data key="d10">chunk_1847..chunk_1849</data>
      <data key="d11">drugs_and_cosmetics_rules_1945_updated_2024.md</data>
    </edge>
    <edge source="air filter placement downstream of humidifier prohibited" target="drugs rules 1945" id="0">
      <data key="d7">STANDARDIZED_UNDER</data>
      <data key="d8">1</data>
      <data key="d9">["Air filters shall not be installed immediately downstream of humidifiers, as moisture on the filters could lead to bacterial growth."]</data>
      <data key="d10">chunk_1847..chunk_1849</data>
      <data key="d11">drugs_and_cosmetics_rules_1945_updated_2024.md</data>
    </edge>
    <edge source="cold surface insulation" target="drugs rules 1945" id="0">
      <data key="d7">STANDARDIZED_UNDER</data>
      <data key="d8">1</data>
      <data key="d9">["Cold surfaces shall be insulated to prevent condensation within the clean area or on air-handling components."]</data>
      <data key="d10">chunk_1847..chunk_1849</data>
      <data key="d11">drugs_and_cosmetics_rules_1945_updated_2024.md</data>
    </edge>
    <edge source="chemical drier usage" target="drugs rules 1945" id="0">
      <data key="d7">STANDARDIZED_UNDER</data>
      <data key="d8">1</data>
      <data key="d9">["Chemical driers using silica gel or lithium chloride are acceptable, provided that they do not become sources of contamination."]</data>
      <data key="d10">chunk_1847..chunk_1849</data>
      <data key="d11">drugs_and_cosmetics_rules_1945_updated_2024.md</data>
    </edge>
