    <edge source="medicinal gas" target="who good manufacturing practices" id="0">
      <data key="d7">GOVERNED_BY</data>
      <data key="d8">6</data>
      <data key="d9">["Chunk chunk_8299: Any complaint concerning a defect of a medicinal gas should be recorded in detail and thoroughly investigated.", "Chunk chunk_8299: There should be a written, authorized procedure describing the managing of a recall of medicinal gases.", "Chunk chunk_8300: There should be a written authorized procedure describing the managing of returns of medicinal gases, which may include inspection or testing.", "Chunk chunk_8300: Self-inspections should be carried out according to a written, authorized procedure.", "Chunk chunk_8300: Self-inspections should be performed routinely and, in addition, may be performed on special occasions.", "Chunk chunk_8301: Self-inspections should be done by a team of personnel with knowledge of the manufacture and control of medicinal gases and who are qualified to evaluate compliance with GxP."]</data>
      <data key="d10">chunk_8299..chunk_8301</data>
      <data key="d11">who_gmp_guidelines.md</data>
    </edge>
    <edge source="medicinal gas" target="gmp standards" id="0">
      <data key="d7">REQUIRES_COMPLIANCE</data>
      <data key="d8">1</data>
      <data key="d9">["Filling and distribution manifolds should be dedicated to a single medicinal gas ... and GMP standards should be maintained."]</data>
      <data key="d10">chunk_8305..chunk_8307</data>
      <data key="d11">who_gmp_guidelines.md</data>
    </edge>
    <edge source="medicinal gas" target="who gmp guidelines" id="0">
      <data key="d7">GOVERNED_BY</data>
      <data key="d8">1</data>
      <data key="d9">["Each batch of medicinal gas (cylinders, mobile cryogenic vessels, tanks) should be tested in accordance with the marketing authorization, authorized specification or pharmacopoeia and a record of analysis should be maintained, for example a certificate of analysis."]</data>
      <data key="d10">chunk_8320..chunk_8322</data>
      <data key="d11">who_gmp_guidelines.md</data>
    </edge>
    <edge source="periodic management review" target="who good manufacturing practices" id="0">
      <data key="d7">STANDARDIZED_UNDER</data>
      <data key="d8">1</data>
      <data key="d9">["There should be periodic management reviews, with the involvement of senior management, of the operation of the PQS ... should be conducted at least annually."]</data>
      <data key="d10">chunk_7075..chunk_7077</data>
      <data key="d11">who_gmp_guidelines.md</data>
    </edge>
    <edge source="product quality review" target="who good manufacturing practices" id="0">
      <data key="d7">STANDARDIZED_UNDER</data>
      <data key="d8">1</data>
      <data key="d9">["Regular, periodic or rolling quality reviews of all pharmaceutical products ... should be conducted with the objective of verifying the consistency of the existing process ..."]</data>
      <data key="d10">chunk_7075..chunk_7077</data>
      <data key="d11">who_gmp_guidelines.md</data>
    </edge>
    <edge source="qualification and validation programme" target="gmp" id="0">
      <data key="d7">STANDARDIZED_UNDER</data>
      <data key="d8">1</data>
      <data key="d9">["In accordance with GMP, each pharmaceutical company should identify what qualification and validation work is required to prove that the critical aspects of their particular operation are controlled."]</data>
      <data key="d10">chunk_7081..chunk_7083</data>
      <data key="d11">who_gmp_guidelines.md</data>
    </edge>
    <edge source="clean body coverings" target="who good manufacturing practices" id="0">
      <data key="d7">STANDARDIZED_UNDER</data>
      <data key="d8">1</data>
