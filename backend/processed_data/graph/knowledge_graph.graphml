      <data key="d10">chunk_7114..chunk_7116</data>
      <data key="d11">who_gmp_guidelines.md</data>
    </edge>
    <edge source="protective clothing" target="who good manufacturing practices" id="0">
      <data key="d7">STANDARDIZED_UNDER</data>
      <data key="d8">1</data>
      <data key="d9">["Personal hygiene procedures, including the wearing of protective clothing, should apply to all persons entering production areas"]</data>
      <data key="d10">chunk_7114..chunk_7116</data>
      <data key="d11">who_gmp_guidelines.md</data>
    </edge>
