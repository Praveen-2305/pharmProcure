    <edge source="medicinal gases" target="who gmp guidelines" id="0">
      <data key="d7">GOVERNED_BY</data>
      <data key="d8">5</data>
      <data key="d9">["GMP for medicinal gases addresses requirements for the production, control, storage and distribution of medicinal gases.", "satisfactory arrangements exist to ensure that medicinal gases are filled, stored, distributed and subsequently handled so that their quality is maintained.", "The premises where medicinal gases are manufactured should be located, designed, constructed and maintained to suit the operations to be carried out.", "The manufacturing of medicinal gases should generally be carried out in closed equipment.", "Manufacturers of medicinal gases should consider adopting a life cycle approach and continuous improvement."]</data>
      <data key="d10">chunk_7042..chunk_7044, chunk_8293..chunk_8295, chunk_8302..chunk_8304, chunk_8308..chunk_8310, chunk_8326..chunk_8328</data>
      <data key="d11">who_gmp_guidelines.md</data>
    </edge>
