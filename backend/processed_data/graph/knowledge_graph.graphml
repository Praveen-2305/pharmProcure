    <edge source="reference material" target="who gmp guidelines" id="0">
      <data key="d7">GOVERNED_BY</data>
      <data key="d8">1</data>
      <data key="d9">["Reference materials may be necessary for the calibration and/or qualification of equipment, instruments or other devices."]</data>
      <data key="d10">chunk_9730..chunk_9732</data>
      <data key="d11">who_gmp_guidelines.md</data>
    </edge>
    <edge source="operation qualification" target="who gmp guidelines" id="0">
      <data key="d7">STANDARDIZED_UNDER</data>
      <data key="d8">1</data>
      <data key="d9">["Laboratory equipment should undergo design qualification, installation qualification, operation qualification and performance qualification (chunk_9737)"]</data>
      <data key="d10">chunk_9736..chunk_9738</data>
      <data key="d11">who_gmp_guidelines.md</data>
    </edge>
    <edge source="calibration" target="who gmp guidelines" id="0">
      <data key="d7">STANDARDIZED_UNDER</data>
      <data key="d8">2</data>
      <data key="d9">["Measuring equipment should be regularly calibrated according to a plan established by the laboratory (chunk_9738)", "calibration . The set of operations that establish, under specified conditions, the relationship between values indicated by an instrument or system for measuring (especially weighing), recording and controlling, or the values represented by a material measure, and the corresponding known values of a reference standard."]</data>
      <data key="d10">chunk_9736..chunk_9738, chunk_9853..chunk_9855</data>
      <data key="d11">who_gmp_guidelines.md</data>
    </edge>
    <edge source="certificate of analysis" target="who gmp guidelines" id="0">
      <data key="d7">STANDARDIZED_UNDER</data>
      <data key="d8">1</data>
      <data key="d9">["The Guideline on model certificate of analysis was adopted by the WHO Expert Committee on Specifications for Pharmaceutical Preparations"]</data>
      <data key="d10">chunk_9766..chunk_9768</data>
      <data key="d11">who_gmp_guidelines.md</data>
    </edge>
    <edge source="retained samples" target="who gmp guidelines" id="0">
      <data key="d7">STANDARDIZED_UNDER</data>
      <data key="d8">1</data>
      <data key="d9">["20.1 Samples should be retained as required by the legislation or by the originator of the request for analysis."]</data>
      <data key="d10">chunk_9766..chunk_9768</data>
      <data key="d11">who_gmp_guidelines.md</data>
    </edge>
    <edge source="good practices for pharmaceutical microbiology laboratories" target="who technical report series 961 2011" id="0">
      <data key="d7">STANDARDIZED_UNDER</data>
      <data key="d8">1</data>
      <data key="d9">["5.2 WHO good practices for pharmaceutical microbiology laboratories Annex 2, WHO Technical Report Series, 961, 2011"]</data>
      <data key="d10">chunk_9790..chunk_9792</data>
      <data key="d11">who_gmp_guidelines.md</data>
    </edge>
    <edge source="temperature and humidity controls" target="who gmp guidelines" id="0">
      <data key="d7">STANDARDIZED_UNDER</data>
      <data key="d8">1</data>
      <data key="d9">["including temperature and humidity controls where required, should be in place for microbiological laboratories."]</data>
      <data key="d10">chunk_9802..chunk_9804</data>
      <data key="d11">who_gmp_guidelines.md</data>
    </edge>
    <edge source="restricted access procedures" target="who gmp guidelines" id="0">
      <data key="d7">STANDARDIZED_UNDER</data>
      <data key="d8">1</data>
      <data key="d9">["Access to the microbiological laboratory should be restricted to authorized personnel."]</data>
      <data key="d10">chunk_9802..chunk_9804</data>
      <data key="d11">who_gmp_guidelines.md</data>
    </edge>
    <edge source="segregation of laboratory activities" target="who gmp guidelines" id="0">
      <data key="d7">STANDARDIZED_UNDER</data>
      <data key="d8">1</data>
      <data key="d9">["Laboratory activities ... should be segregated by space or at least in time, so as to minimize risks of cross-contamination."]</data>
      <data key="d10">chunk_9802..chunk_9804</data>
      <data key="d11">who_gmp_guidelines.md</data>
    </edge>
    <edge source="dedicated sterility testing area" target="who gmp guidelines" id="0">
      <data key="d7">STANDARDIZED_UNDER</data>
      <data key="d8">1</data>
      <data key="d9">["Sterility testing should always be performed in a dedicated area."]</data>
      <data key="d10">chunk_9802..chunk_9804</data>
      <data key="d11">who_gmp_guidelines.md</data>
    </edge>
    <edge source="area classification based on product criticality" target="who gmp guidelines" id="0">
      <data key="d7">STANDARDIZED_UNDER</data>
      <data key="d8">1</data>
      <data key="d9">["Consideration should be given to designing appropriate classified areas ... The classification should be based on the criticality of the product."]</data>
      <data key="d10">chunk_9802..chunk_9804</data>
      <data key="d11">who_gmp_guidelines.md</data>
    </edge>
    <edge source="cleaning and disinfection programme" target="who gmp guidelines" id="0">
      <data key="d7">STANDARDIZED_UNDER</data>
      <data key="d8">1</data>
      <data key="d9">["There should be a documented cleaning and disinfection programme."]</data>
      <data key="d10">chunk_9802..chunk_9804</data>
      <data key="d11">who_gmp_guidelines.md</data>
    </edge>
    <edge source="spillage handling procedure" target="who gmp guidelines" id="0">
      <data key="d7">STANDARDIZED_UNDER</data>
      <data key="d8">1</data>
      <data key="d9">["There should be a procedure for dealing with spillages."]</data>
      <data key="d10">chunk_9802..chunk_9804</data>
      <data key="d11">who_gmp_guidelines.md</data>
    </edge>
    <edge source="who gmp section 10 principles" target="who gmp for sterile pharmaceutical products" id="0">
      <data key="d7">STANDARDIZED_UNDER</data>
      <data key="d8">1</data>
      <data key="d9">["Chunk chunk_9808: Garments for the sterility test operator should comply with the principles of section 10 of WHO GMP for sterile pharmaceutical products."]</data>
      <data key="d10">chunk_9808..chunk_9810</data>
      <data key="d11">who_gmp_guidelines.md</data>
    </edge>
    <edge source="who gmp section 11 requirements" target="who gmp for sterile pharmaceutical products" id="0">
      <data key="d7">STANDARDIZED_UNDER</data>
      <data key="d8">1</data>
      <data key="d9">["Chunk chunk_9808: The fittings and finishes of the premises should comply with section 11 of WHO GMP for sterile pharmaceutical products."]</data>
      <data key="d10">chunk_9808..chunk_9810</data>
      <data key="d11">who_gmp_guidelines.md</data>
    </edge>
    <edge source="who gmp environmental microbiological monitoring" target="who gmp for sterile pharmaceutical products" id="0">
      <data key="d7">STANDARDIZED_UNDER</data>
      <data key="d8">1</data>
      <data key="d9">["Chunk chunk_9809: Microbial environmental monitoring of the sterility test zone should be performed during every work session under operational (dynamic) conditions."]</data>
      <data key="d10">chunk_9808..chunk_9810</data>
      <data key="d11">who_gmp_guidelines.md</data>
    </edge>
    <edge source="who gmp test method validation" target="who gmp for sterile pharmaceutical products" id="0">
      <data key="d7">STANDARDIZED_UNDER</data>
      <data key="d8">1</data>
      <data key="d9">["Chunk chunk_9810: Test methods not based on compendial or other recognized references should be validated before use."]</data>
      <data key="d10">chunk_9808..chunk_9810</data>
      <data key="d11">who_gmp_guidelines.md</data>
    </edge>
    <edge source="who gmp equipment qualification" target="who gmp for sterile pharmaceutical products" id="0">
      <data key="d7">STANDARDIZED_UNDER</data>
      <data key="d8">1</data>
      <data key="d9">["Chunk chunk_9810: As part of its quality system, a laboratory should have a documented programme for the qualification, calibration, performance verification, maintenance and a system for monitoring the use of its equipment."]</data>
      <data key="d10">chunk_9808..chunk_9810</data>
      <data key="d11">who_gmp_guidelines.md</data>
    </edge>
    <edge source="maintenance essential equipment intervals" target="who gmp guidelines" id="0">
      <data key="d7">STANDARDIZED_UNDER</data>
      <data key="d8">1</data>
      <data key="d9">["Maintenance of essential equipment should be carried out at predetermined intervals in accordance with a documented procedure."]</data>
      <data key="d10">chunk_9811..chunk_9813</data>
      <data key="d11">who_gmp_guidelines.md</data>
    </edge>
    <edge source="calibration traceability temperature standards" target="who gmp guidelines" id="0">
      <data key="d7">STANDARDIZED_UNDER</data>
      <data key="d8">1</data>
      <data key="d9">["Calibration of devices should be traceable to national or international standards for temperature."]</data>
      <data key="d10">chunk_9811..chunk_9813</data>
      <data key="d11">who_gmp_guidelines.md</data>
    </edge>
    <edge source="temperature measurement device quality" target="who gmp guidelines" id="0">
      <data key="d7">STANDARDIZED_UNDER</data>
      <data key="d8">1</data>
      <data key="d9">["temperature measuring devices should be of appropriate quality to achieve the accuracy required (e.g. liquid-in-glass thermometers, thermocouples and platinum resistance thermometers (PRTs) used in incubators and autoclaves)."]</data>
      <data key="d10">chunk_9811..chunk_9813</data>
      <data key="d11">who_gmp_guidelines.md</data>
    </edge>
    <edge source="equipment operating temperature monitoring" target="who gmp guidelines" id="0">
      <data key="d7">STANDARDIZED_UNDER</data>
      <data key="d8">1</data>
      <data key="d9">["The operating temperature of this type of equipment should be monitored and records retained."]</data>
      <data key="d10">chunk_9811..chunk_9813</data>
      <data key="d11">who_gmp_guidelines.md</data>
    </edge>
    <edge source="calibrated weights and balances" target="who gmp guidelines" id="0">
      <data key="d7">STANDARDIZED_UNDER</data>
      <data key="d8">1</data>
      <data key="d9">["Weights and balances shall be calibrated traceably at regular intervals (according to their intended use) using appropriate standard weights traceable to certified standard weights."]</data>
      <data key="d10">chunk_9817..chunk_9819</data>
      <data key="d11">who_gmp_guidelines.md</data>
    </edge>
    <edge source="verification of volumetric equipment" target="who gmp guidelines" id="0">
      <data key="d7">STANDARDIZED_UNDER</data>
      <data key="d8">1</data>
      <data key="d9">["Microbiology laboratories should carry out initial verification of volumetric equipment ... and then make regular checks, as appropriate, to ensure that the equipment is performing within the required specification."]</data>
      <data key="d10">chunk_9817..chunk_9819</data>
      <data key="d11">who_gmp_guidelines.md</data>
    </edge>
    <edge source="procurement from recognized quality system" target="who gmp guidelines" id="0">
      <data key="d7">STANDARDIZED_UNDER</data>
      <data key="d8">1</data>
      <data key="d9">["For \u201csingle-use\u201d disposable volumetric equipment, laboratories should obtain supplies from companies with a recognized and relevant quality system."]</data>
      <data key="d10">chunk_9817..chunk_9819</data>
      <data key="d11">who_gmp_guidelines.md</data>
    </edge>
    <edge source="calibration of hygrometers" target="who gmp guidelines" id="0">
      <data key="d7">STANDARDIZED_UNDER</data>
      <data key="d8">1</data>
      <data key="d9">["Where humidity is important to the outcome of the test, hygrometers should be calibrated, the calibration being traceable to national or international standards."]</data>
      <data key="d10">chunk_9817..chunk_9819</data>
      <data key="d11">who_gmp_guidelines.md</data>
    </edge>
    <edge source="verification of conductivity oxygen ph meters" target="who gmp guidelines" id="0">
      <data key="d7">STANDARDIZED_UNDER</data>
      <data key="d8">1</data>
      <data key="d9">["Conductivity meters, oxygen meters, pH meters and other similar instruments should be verified regularly or before each use."]</data>
      <data key="d10">chunk_9817..chunk_9819</data>
      <data key="d11">who_gmp_guidelines.md</data>
    </edge>
    <edge source="verification of timers" target="who gmp guidelines" id="0">
      <data key="d7">STANDARDIZED_UNDER</data>
      <data key="d8">1</data>
      <data key="d9">["Timers, including the autoclave timer, should be verified using a calibrated timer or national time signal."]</data>
      <data key="d10">chunk_9817..chunk_9819</data>
      <data key="d11">who_gmp_guidelines.md</data>
    </edge>
    <edge source="calibration of centrifuge" target="who gmp guidelines" id="0">
      <data key="d7">STANDARDIZED_UNDER</data>
      <data key="d8">1</data>
      <data key="d9">["When centrifuges are used in test procedures, an assessment of the rotations per minute (RPM) should be made. Where it is critical, the centrifuge should be calibrated."]</data>
      <data key="d10">chunk_9817..chunk_9819</data>
      <data key="d11">who_gmp_guidelines.md</data>
    </edge>
    <edge source="verification of reagents" target="who gmp guidelines" id="0">
      <data key="d7">STANDARDIZED_UNDER</data>
      <data key="d8">1</data>
      <data key="d9">["Laboratories should verify the suitability of each batch of reagents critical for the test, initially and during its shelf-life."]</data>
      <data key="d10">chunk_9817..chunk_9819</data>
      <data key="d11">who_gmp_guidelines.md</data>
    </edge>
    <edge source="autoclave temperature tolerance monitoring" target="who gmp guidelines" id="0">
      <data key="d7">STANDARDIZED_UNDER</data>
      <data key="d8">1</data>
      <data key="d9">["Autoclaves should be capable of meeting specified time and temperature tolerances; monitoring pressure alone is not acceptable."]</data>
      <data key="d10">chunk_9814..chunk_9816</data>
      <data key="d11">who_gmp_guidelines.md</data>
    </edge>
    <edge source="autoclave sensor calibration" target="who gmp guidelines" id="0">
      <data key="d7">STANDARDIZED_UNDER</data>
      <data key="d8">1</data>
      <data key="d9">["Sensors used for controlling or monitoring operating cycles require calibration and the performance of timers should be verified."]</data>
      <data key="d10">chunk_9814..chunk_9816</data>
      <data key="d11">who_gmp_guidelines.md</data>
    </edge>
    <edge source="autoclave performance validation" target="who gmp guidelines" id="0">
      <data key="d7">STANDARDIZED_UNDER</data>
      <data key="d8">1</data>
      <data key="d9">["Initial validation should include performance studies (spatial temperature distribution surveys) for each operating cycle and each load configuration used in practice."]</data>
      <data key="d10">chunk_9814..chunk_9816</data>
      <data key="d11">who_gmp_guidelines.md</data>
    </edge>
    <edge source="autoclave revalidation after modification" target="who gmp guidelines" id="0">
      <data key="d7">STANDARDIZED_UNDER</data>
      <data key="d8">1</data>
      <data key="d9">["This process must be repeated after any significant repair or modification (e.g. replacement of thermoregulator probe or programmer, change to loading arrangements or operating cycle) or where indicated by the results of quality control checks on media or risk assessment."]</data>
      <data key="d10">chunk_9814..chunk_9816</data>
      <data key="d11">who_gmp_guidelines.md</data>
    </edge>
    <edge source="autoclave operating instructions and records" target="who gmp guidelines" id="0">
      <data key="d7">STANDARDIZED_UNDER</data>
      <data key="d8">2</data>
      <data key="d9">["Clear operating instructions should be provided based on the heating profiles determined for typical uses during validation/revalidation.", "Acceptance/ rejection criteria should be established and records of autoclave operations, including temperature and time, maintained for every cycle."]</data>
      <data key="d10">chunk_9814..chunk_9816</data>
      <data key="d11">who_gmp_guidelines.md</data>
    </edge>
    <edge source="autoclave temperature monitoring methods" target="who gmp guidelines" id="0">
      <data key="d7">STANDARDIZED_UNDER</data>
      <data key="d8">1</data>
      <data key="d9">["using a thermocouple and recorder to produce a chart or printout; direct observation and recording of maximum temperature achieved and time at that temperature."]</data>
      <data key="d10">chunk_9814..chunk_9816</data>
      <data key="d11">who_gmp_guidelines.md</data>
    </edge>
    <edge source="autoclave chemical indicator usage" target="who gmp guidelines" id="0">
      <data key="d7">STANDARDIZED_UNDER</data>
      <data key="d8">2</data>
      <data key="d9">["In addition to directly monitoring the temperature of an autoclave, the effectiveness of its operation during each cycle may be checked by the use of chemical or biological indicators for sterilization or decontamination purposes.", "Autoclave tape or indicator strips should be used only to show that a load has been processed, not to demonstrate completion of an acceptable cycle."]</data>
      <data key="d10">chunk_9814..chunk_9816</data>
      <data key="d11">who_gmp_guidelines.md</data>
    </edge>
    <edge source="alcoa" target="who gmp guidelines" id="0">
      <data key="d7">STANDARDIZED_UNDER</data>
      <data key="d8">1</data>
      <data key="d9">["ALCOA . A commonly used acronym for \u201cattributable, legible, contemporaneous, original and accurate\u201d."]</data>
      <data key="d10">chunk_9853..chunk_9855</data>
      <data key="d11">who_gmp_guidelines.md</data>
    </edge>
    <edge source="back up" target="who gmp guidelines" id="0">
      <data key="d7">STANDARDIZED_UNDER</data>
      <data key="d8">1</data>
      <data key="d9">["back-up . A copy of one or more electronic files created as an alternative in case the original data or system are lost or become unusable (for example, in the event of a system crash or corruption of a disk)."]</data>
      <data key="d10">chunk_9853..chunk_9855</data>
      <data key="d11">who_gmp_guidelines.md</data>
    </edge>
    <edge source="date and time functions" target="who gmp guidelines" id="0">
      <data key="d7">STANDARDIZED_UNDER</data>
      <data key="d8">2</data>
      <data key="d9">["7.1 Chromatographic systems should have date and time functions enabled from the time of installation of the software.", "7.2 The date and time function should be locked, and access to change the date and time should be controlled."]</data>
      <data key="d10">chunk_9862..chunk_9864</data>
      <data key="d11">who_gmp_guidelines.md</data>
    </edge>
    <edge source="electronic system" target="who gmp guidelines" id="0">
      <data key="d7">STANDARDIZED_UNDER</data>
      <data key="d8">1</data>
      <data key="d9">["8.1 Written procedures should be followed when a new electronic system is taken into use."]</data>
