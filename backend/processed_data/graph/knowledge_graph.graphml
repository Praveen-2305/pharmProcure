      <data key="d9">["Certain allergenic ingredients (e.g. penicillins and cephalosporins) and highly potent material (e.g. anovulent steroids, potent steroids and cytotoxics) should be undetectable by the best available analytical methods."]</data>
      <data key="d10">chunk_7243..chunk_7245</data>
      <data key="d11">who_gmp_guidelines.md</data>
    </edge>
    <edge source="cytotoxics" target="who good manufacturing practices" id="0">
      <data key="d7">REQUIRES_COMPLIANCE</data>
      <data key="d8">1</data>
      <data key="d9">["Certain allergenic ingredients (e.g. penicillins and cephalosporins) and highly potent material (e.g. anovulent steroids, potent steroids and cytotoxics) should be undetectable by the best available analytical methods."]</data>
      <data key="d10">chunk_7243..chunk_7245</data>
      <data key="d11">who_gmp_guidelines.md</data>
    </edge>
    <edge source="linearity" target="who gmp guidelines" id="0">
      <data key="d7">STANDARDIZED_UNDER</data>
      <data key="d8">1</data>
      <data key="d9">["9.1.4 _Linearity_ indicates the ability to produce results that are directly proportional to the concentration of the analyte in samples."]</data>
      <data key="d10">chunk_7261..chunk_7263</data>
      <data key="d11">who_gmp_guidelines.md</data>
    </edge>
    <edge source="range" target="who gmp guidelines" id="0">
      <data key="d7">STANDARDIZED_UNDER</data>
      <data key="d8">1</data>
      <data key="d9">["9.1.5 _Range_ is an expression of the lowest and highest levels of analyte for which it has been demonstrated that the analytical procedure has a suitable level of precision, accuracy and linearity."]</data>
      <data key="d10">chunk_7261..chunk_7263</data>
      <data key="d11">who_gmp_guidelines.md</data>
    </edge>
    <edge source="specificity" target="who gmp guidelines" id="0">
      <data key="d7">STANDARDIZED_UNDER</data>
      <data key="d8">1</data>
      <data key="d9">["9.1.6 _Specificity (selectivity)_ is the ability to measure unequivocally the desired analyte in the presence of components such as excipients and impurities that may also be expected to be present."]</data>
      <data key="d10">chunk_7261..chunk_7263</data>
      <data key="d11">who_gmp_guidelines.md</data>
    </edge>
    <edge source="detection limit" target="who gmp guidelines" id="0">
      <data key="d7">STANDARDIZED_UNDER</data>
      <data key="d8">1</data>
      <data key="d9">["9.1.7 _Detection limit (limit of detection)_ is the smallest quantity of an analyte that can be detected, and not necessarily determined, in a quantitative fashion."]</data>
      <data key="d10">chunk_7261..chunk_7263</data>
      <data key="d11">who_gmp_guidelines.md</data>
    </edge>
    <edge source="quantitation limit" target="who gmp guidelines" id="0">
      <data key="d7">STANDARDIZED_UNDER</data>
      <data key="d8">1</data>
      <data key="d9">["9.1.8 _Quantitation limit_ ( _limit of quantitation_ ) is the lowest concentration of an analyte in a sample that may be determined with acceptable accuracy and precision."]</data>
      <data key="d10">chunk_7261..chunk_7263</data>
      <data key="d11">who_gmp_guidelines.md</data>
    </edge>
