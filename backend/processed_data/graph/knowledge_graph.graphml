      <data key="d7">STANDARDIZED_UNDER</data>
      <data key="d8">1</data>
      <data key="d9">["During the retention period, originals or copies of records should be readily available at the establishment where the activities described in these records occurred."]</data>
      <data key="d10">chunk_7597..chunk_7599</data>
      <data key="d11">who_gmp_guidelines.md</data>
    </edge>
    <edge source="true copy retention and retrieval" target="who gmp guidelines" id="0">
      <data key="d7">STANDARDIZED_UNDER</data>
      <data key="d8">1</data>
      <data key="d9">["Specifications, instructions, procedures and records can be retained either as originals or as true copies such as photocopies, microfilm, microfiche, or other accurate reproductions of the original records. ... suitable retrieval equipment and a means to produce a hard copy should be readily available."]</data>
      <data key="d10">chunk_7597..chunk_7599</data>
      <data key="d11">who_gmp_guidelines.md</data>
    </edge>
