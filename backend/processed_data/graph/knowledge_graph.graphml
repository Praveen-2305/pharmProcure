    <edge source="investigational radiopharmaceuticals" target="who gmp guidelines" id="0">
      <data key="d7">GOVERNED_BY</data>
      <data key="d8">2</data>
      <data key="d9">["GMP for investigational radiopharmaceuticals addresses current expectations and trends in GMP specific to investigational radiopharmaceuticals used in clinical trials.", "During the manufacture of investigational radiopharmaceuticals for phase I\u2013II clinical trials, the in-house testing may also be in the form of a review of the certificate of analysis supplied by the reliable material supplier, to confirm compliance with the specification set by the investigational agent manufacturer."]</data>
      <data key="d10">chunk_7042..chunk_7044, chunk_8557..chunk_8559</data>
      <data key="d11">who_gmp_guidelines.md</data>
    </edge>
