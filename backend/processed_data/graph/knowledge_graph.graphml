    <edge source="api" target="accelerated storage condition" id="0">
      <data key="d7">REQUIRES_STORAGE</data>
      <data key="d8">2</data>
      <data key="d9">["When testing at the intermediate storage condition is called for as a result of significant change at the accelerated storage condition, a minimum of four time points, including the initial and final time points (e.g. 0, 6, 9 and 12 months), from a 12-month study is recommended.", "At the accelerated storage condition, a minimum of three time points, including the initial and final time points (e.g. 0, 3 and 6 months), from a six-month study is recommended."]</data>
      <data key="d10">chunk_3293..chunk_3295, chunk_8923..chunk_8925</data>
      <data key="d11">who_drug_quality_guidelines.md</data>
    </edge>
    <edge source="api" target="intermediate storage condition" id="0">
      <data key="d7">REQUIRES_STORAGE</data>
      <data key="d8">2</data>
      <data key="d9">["When testing at the intermediate storage condition is called for as a result of significant change at the accelerated storage condition, a minimum of four time points, including the initial and final time points (e.g. 0, 6, 9 and 12 months), from a 12-month study is recommended."]</data>
      <data key="d10">chunk_3293..chunk_3295, chunk_8923..chunk_8925</data>
      <data key="d11">who_drug_quality_guidelines.md</data>
    </edge>
    <edge source="api" target="highly soluble criteria" id="0">
      <data key="d7">REQUIRES_COMPLIANCE</data>
      <data key="d8">1</data>
      <data key="d9">["An API is classified as highly soluble if the highest single therapeutic dose is completely soluble in 250 millilitres (mL) or less of aqueous media over the pH range 1.2\u20136.8 at 37 (\u00b1 1) \u00b0C."]</data>
      <data key="d10">chunk_3659..chunk_3661</data>
      <data key="d11">who_drug_quality_guidelines.md</data>
    </edge>
    <edge source="api" target="who gmp guidelines" id="0">
      <data key="d7">REQUIRES_COMPLIANCE</data>
      <data key="d8">2</data>
      <data key="d9">["chunk_4619: to assess compliance with the relevant sections of WHO GMP guidelines", "This GMP guide does not apply to steps prior to the introduction of the defined \u201cAPI starting material\u201d."]</data>
      <data key="d10">chunk_4619..chunk_4621, chunk_7570..chunk_7572</data>
