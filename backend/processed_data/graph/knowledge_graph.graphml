      <data key="d9">["If the blending could adversely affect stability, stability testing of the final blended batches should be performed."]</data>
      <data key="d10">chunk_7621..chunk_7623</data>
      <data key="d11">who_gmp_guidelines.md</data>
    </edge>
    <edge source="api" target="traceability of batch records" id="0">
      <data key="d7">REQUIRES_COMPLIANCE</data>
      <data key="d8">1</data>
      <data key="d9">["The batch record of the blending process should allow traceability back to the individual batches that make up the blend."]</data>
      <data key="d10">chunk_7621..chunk_7623</data>
      <data key="d11">who_gmp_guidelines.md</data>
    </edge>
    <edge source="api" target="contamination control" id="0">
      <data key="d7">REQUIRES_COMPLIANCE</data>
      <data key="d8">1</data>
      <data key="d9">["Production operations should be conducted in a manner that will prevent contamination of intermediates or APIs by other materials."]</data>
      <data key="d10">chunk_7621..chunk_7623</data>
      <data key="d11">who_gmp_guidelines.md</data>
    </edge>
    <edge source="api" target="clean containers" id="0">
      <data key="d7">REQUIRES_COMPLIANCE</data>
      <data key="d8">1</data>
      <data key="d9">["Containers should be clean and, where indicated by the nature of the intermediate or API, sanitized to ensure that they are suitable for their intended use."]</data>
      <data key="d10">chunk_7624..chunk_7626</data>
      <data key="d11">who_gmp_guidelines.md</data>
    </edge>
    <edge source="api" target="established specifications" id="0">
      <data key="d7">REQUIRES_COMPLIANCE</data>
      <data key="d8">1</data>
      <data key="d9">["Packaging and labelling materials should conform to established specifications."]</data>
      <data key="d10">chunk_7624..chunk_7626</data>
      <data key="d11">who_gmp_guidelines.md</data>
    </edge>
    <edge source="api" target="written procedures label handling" id="0">
      <data key="d7">REQUIRES_COMPLIANCE</data>
      <data key="d8">1</data>
      <data key="d9">["There should be written procedures describing the receipt, identification, quarantine, sampling, examination and/or testing and release and handling of packaging and labelling materials."]</data>
      <data key="d10">chunk_7624..chunk_7626</data>
      <data key="d11">who_gmp_guidelines.md</data>
    </edge>
    <edge source="api" target="label requirements" id="0">
      <data key="d7">REQUIRES_COMPLIANCE</data>
      <data key="d8">1</data>
      <data key="d9">["Labels used on containers of intermediates or APIs should indicate the name or identifying code, the batch number of the product and the storage conditions, when such information is critical to assure the quality of the intermediate or API. (chunk_7627)"]</data>
      <data key="d10">chunk_7627..chunk_7629</data>
      <data key="d11">who_gmp_guidelines.md</data>
    </edge>
