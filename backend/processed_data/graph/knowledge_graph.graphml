      <data key="d7">STANDARDIZED_UNDER</data>
      <data key="d8">1</data>
      <data key="d9">["Point-of-use extraction, i.e., as close as possible to the point where the dust is generated, shall be employed."]</data>
      <data key="d10">chunk_1847..chunk_1849</data>
      <data key="d11">drugs_and_cosmetics_rules_1945_updated_2024.md</data>
    </edge>
