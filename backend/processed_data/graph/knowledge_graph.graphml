      <data key="d7">STANDARDIZED_UNDER</data>
      <data key="d8">1</data>
      <data key="d9">["Chunk chunk_10038: control of temperature and, where necessary, humidity"]</data>
      <data key="d10">chunk_10038..chunk_10041</data>
