    <edge source="acceptable temp limits" target="temperature data logger" id="0">
      <data key="d7">REQUIRES_COMPLIANCE</data>
      <data key="d8">1</data>
      <data key="d9">["Storage areas should be maintained within acceptable and specified temperature limits. Where the labels show special storage conditions are required (e.g. temperature, relative humidity), these should be provided, controlled, monitored and recorded."]</data>
      <data key="d10">chunk_9280..chunk_9282</data>
      <data key="d11">who_gmp_guidelines.md</data>
    </edge>
