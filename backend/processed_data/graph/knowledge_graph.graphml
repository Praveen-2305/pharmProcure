      <data key="d7">STANDARDIZED_UNDER</data>
      <data key="d8">2</data>
      <data key="d9">["Documented verification that the installations (such as machines equipment and instruments, computer system components, measuring devices, utilities and manufacturing) used in a processor system are appropriately selected and correctly installed, in accordance with established specifications.", "design qualification (DQ), a factory acceptance test (FAT), site acceptance test (SAT), installation qualification (IQ), operational qualification (OQ) and performance qualification (PQ)."]</data>
