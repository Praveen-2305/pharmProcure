# ==============================================================================
# AutonoSource (pharmProcure) — Backend Environment Configuration Template
# Copy this file to .env and supply your credentials:
#   copy .env.example .env
# ==============================================================================

# Server Network Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=info

# Python Encoding for Windows Console (prevents Indian Rupee ₹ charmap crash)
PYTHONIOENCODING=utf-8

# LLM Providers (Optional - Rule-based fallback active if keys are absent)
# Groq API for Fast Extraction (Recommended)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# OpenAI API (Alternative LLM fallback)
OPENAI_API_KEY=

# Google Gemini API
GEMINI_API_KEY=

# Web Scraping & External Due Diligence (Optional - DuckDuckGo fallback active)
# Tavily Search API Key for CDSCO / FDA warning letters and recall crawling
TAVILY_API_KEY=

# Vector Database (Qdrant)
QDRANT_HOST=:memory:
QDRANT_STORAGE_PATH=processed_data/qdrant
QDRANT_COLLECTION=procurement_contracts

# Knowledge Graph & Relational Database
SQLITE_DB_PATH=processed_data/sqlite/procurement_cases.db
KNOWLEDGE_GRAPH_PATH=processed_data/graph/knowledge_graph.graphml

# MongoDB (Optional legacy store)
MONGODB_URI=mongodb://localhost:27017
