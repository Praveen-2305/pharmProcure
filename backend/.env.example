# ==============================================================================
# AutonoSource Backend Environment Configuration
# Copy this file to .env and configure your credentials and connection strings:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LLM Engine (Groq)
# Primary LLM provider for agent reasoning, report writing, and knowledge graph construction.
# Obtain API key from: https://console.groq.com/keys
# ------------------------------------------------------------------------------
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Optional: Comma-separated API key ring for high-throughput batch graph building
# GROQ_API_KEYS=gsk_key1,gsk_key2,gsk_key3

# ------------------------------------------------------------------------------
# 2. Web Due Diligence & Search (Tavily)
# Used by the Scraper Agent for live external regulatory due diligence
# (CDSCO alerts, FDA 483 citations, MCA filings, and adverse news).
# Obtain API key from: https://app.tavily.com/
# ------------------------------------------------------------------------------
TAVILY_API_KEY=your_tavily_api_key_here

# ------------------------------------------------------------------------------
# 3. Alternative / Fallback LLM (Google Gemini)
# Optional fallback LLM provider.
# Obtain API key from: https://aistudio.google.com/
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# 4. Storage & Database Endpoints
# Note: Relational SQLite database is located at:
#       backend/processed_data/sqlite/procurement_cases.db
# Pre-computed Qdrant vector store is located at:
#       backend/processed_data/qdrant/
# ------------------------------------------------------------------------------
QDRANT_HOST=:memory:
MONGODB_URI=mongodb://localhost:27017

# ------------------------------------------------------------------------------
# 5. Server Configuration
# ------------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
