# ==============================================================================
# AutonoSource — Environment Configuration Template (.env)
# Copy this file to .env before starting Docker Compose or cloud deployment:
#   cp .env.example .env
# ==============================================================================

# --- AI & LLM Engine (Groq / Gemini) ---
# Primary LLM provider for agent reasoning, report writing, and analysis.
# Sign up and generate API key: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Optional fallback LLM provider
# Sign up: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# --- Live Due Diligence Web Search (Tavily) ---
# Used for live CDSCO notices, FDA 483 citations, and regulatory web crawling.
# Sign up: https://app.tavily.com/
TAVILY_API_KEY=your_tavily_api_key_here

# --- Frontend Settings ---
# Leave empty for same-domain proxying or set to backend URL in separated deployments
VITE_API_BASE_URL=http://localhost:8000
# Set to 'false' for live backend communication, 'true' for standalone mock mode
VITE_USE_MOCK_API=false

# --- Deployment Port Mappings (Docker) ---
BACKEND_PORT=8000
FRONTEND_PORT=3000
